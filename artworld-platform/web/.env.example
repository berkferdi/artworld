APP_ENV=local
APP_DEBUG=true
APP_NAME="Art World"
APP_URL=https://artworldapi.com.tr
SITE_NAME="Art World"
SITE_TAGLINE="Dünyanın Buluştuğu Yerdesiniz"

# Unified domain API (same host as web in production)
API_BASE_URL=https://artworldapi.com.tr/api/v1
# Until cutover, staging/prod API may still be:
# API_BASE_URL=https://api.artworldapi.com.tr/api/v1
API_TIMEOUT=12
API_RETRY=1
API_CACHE_TTL=60

DEFAULT_META_DESCRIPTION=Art World TV — Antalya merkezli haber ve canlı yayın platformu.
DEFAULT_OG_IMAGE=
CANONICAL_HOST=https://artworldapi.com.tr

TIMEZONE=Europe/Istanbul
