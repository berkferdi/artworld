APP_ENV=local
APP_DEBUG=true
APP_URL=https://artworldapi.com.tr
APP_NAME="Art World Mobile"
APP_KEY=change-me-to-a-long-random-string
MEDIA_URL=https://artworldapi.com.tr
API_PREFIX=/api/v1

# Video / File Server
# Prefer Admin → File Server UI (encrypted DB settings). Env is fallback.
FILE_SERVER_ENABLED=true
FILE_SERVER_MODE=local
FILE_SERVER_HOST=193.35.155.55
FILE_SERVER_PORT=22
FILE_SERVER_USER=
FILE_SERVER_PASSWORD=
FILE_SERVER_SSH_KEY=
FILE_SERVER_BASE_PATH=/media/videos
FILE_SERVER_PUBLIC_BASE_URL=https://media.artworldapi.com.tr
FILE_SERVER_UPLOAD_URL=
FILE_SERVER_UPLOAD_TOKEN=
FILE_SERVER_TIMEOUT=8

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=artworld
DB_USERNAME=artworld_user
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

SESSION_NAME=artworld_admin_session
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=_csrf_token

UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_PATH=uploads

CORS_ALLOWED_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

FCM_SERVER_KEY=
FCM_ENABLED=false

TIMEZONE=UTC
