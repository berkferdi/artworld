APP_ENV=local
APP_DEBUG=true
APP_URL=http://193.35.155.149
APP_NAME="Art World Mobile"
MEDIA_URL=http://193.35.155.149
API_PREFIX=/api/v1

# Video / File Server
# Probe (cloud): 193.35.155.55 TCP:80/443 open but no HTTP response; SSH closed.
# Default mode=local uses MEDIA_URL (api host) for public playback until remote storage is reachable.
FILE_SERVER_ENABLED=true
FILE_SERVER_MODE=local
FILE_SERVER_HOST=193.35.155.55
FILE_SERVER_PORT=22
FILE_SERVER_USER=
FILE_SERVER_PASSWORD=
FILE_SERVER_SSH_KEY=
FILE_SERVER_BASE_PATH=/var/www/artworld
FILE_SERVER_PUBLIC_BASE_URL=
FILE_SERVER_UPLOAD_URL=
FILE_SERVER_UPLOAD_TOKEN=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=artworld
DB_USERNAME=artworld_user
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

SESSION_NAME=artworld_admin_session
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=_csrf_token

UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_PATH=uploads

CORS_ALLOWED_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

FCM_SERVER_KEY=
FCM_ENABLED=false

TIMEZONE=UTC
